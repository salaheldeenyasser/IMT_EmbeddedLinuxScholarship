{
  "configurations": [
    {
      "name": "Qt Development",
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-gcc-x64",

      // ── compile_commands.json (generated by: cd build && bear -- make) ────
      // When present this overrides includePath/defines for every file listed
      // in the database, giving pixel-perfect IntelliSense.
      // Re-run the build whenever you add new source files.

      // ── Include paths ────────────────────────────────────────────────────
      // ${workspaceFolder}/build/** must be first so MOC-generated files
      // (moc_*.cpp, ui_*.h) are resolved before anything else.
      "includePath": [
        "${workspaceFolder}/**",

        // GCC 13 system headers (exact paths verified on this machine)
        "/usr/include",
        "/usr/include/c++/13",
        "/usr/include/x86_64-linux-gnu/c++/13",
        "/usr/include/c++/13/backward",
        "/usr/lib/gcc/x86_64-linux-gnu/13/include",
        "/usr/lib/gcc/x86_64-linux-gnu/13/include-fixed",
        "/usr/local/include",

        // Qt 6.9.3 — single recursive glob covers all public + private headers
        "/home/seyho/Qt/6.9.3/gcc_64/include/**"
      ],

      // ── Preprocessor defines ─────────────────────────────────────────────
      // One QT_<MODULE>_LIB define per installed Qt module.
      // IntelliSense uses these to activate the correct #ifdef blocks inside
      // Qt headers (e.g. Q_OBJECT expansion, export macros, etc.).
      "defines": [

